# Server environment
# Port the API listens on
PORT=5000

# Comma-separated origins allowed to call the API (your frontend URL).
# Same-origin deployments (serving client/dist from this server) need nothing.
# Use * to allow any origin (fine for a stateless public tool like this).
CLIENT_ORIGIN=https://status-fix-client.vercel.app

# Set to production in deployed environments
# NODE_ENV=production
